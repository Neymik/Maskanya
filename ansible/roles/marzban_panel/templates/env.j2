{{ ansible_managed | comment }}

# Database
SQLALCHEMY_DATABASE_URL=mysql+pymysql://marzban:{{ mariadb_marzban_password }}@mariadb:3306/marzban

# Dashboard admin
SUDO_USERNAME={{ marzban_admin_username }}
SUDO_PASSWORD={{ marzban_admin_password }}

# Subscription URL prefix — clients fetch configs from here
XRAY_SUBSCRIPTION_URL_PREFIX=https://{{ subscription_public_host }}

# UI bind inside the container.
# Marzban refuses to bind anything but 127.0.0.1 unless SSL certs are
# configured (see /code/main.py: when UVICORN_SSL_CERTFILE/KEYFILE are unset,
# it hard-codes host='127.0.0.1' regardless of UVICORN_HOST). We mount the
# host's LE store read-only into the container and point it at the panel
# cert. nginx on the host still terminates the external TLS; the cert here
# is only to unlock the 0.0.0.0 bind. Nginx's proxy_ssl_verify is off for
# this upstream because it's mesh-local.
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_SSL_CERTFILE=/etc/letsencrypt/live/{{ panel_domain }}/fullchain.pem
UVICORN_SSL_KEYFILE=/etc/letsencrypt/live/{{ panel_domain }}/privkey.pem
UVICORN_SSL_CA_TYPE=public

# MariaDB container (used by docker-compose env interpolation)
MARIADB_ROOT_PASSWORD={{ mariadb_root_password }}
MARIADB_MARZBAN_PASSWORD={{ mariadb_marzban_password }}
