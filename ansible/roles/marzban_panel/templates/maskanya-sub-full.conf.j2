{{ ansible_managed | comment }}
# Subscription endpoint — public. Proxies only the /sub/ path to Marzban;
# everything else returns 404 to keep the surface minimal.

server {
    listen 80;
    listen [::]:80;
    server_name {{ subscription_public_host }};

    location /.well-known/acme-challenge/ {
        root {{ certbot_webroot }};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ subscription_public_host }};

    ssl_certificate     /etc/letsencrypt/live/{{ subscription_public_host }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ subscription_public_host }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    access_log /var/log/nginx/maskanya-sub.access.log;
    error_log  /var/log/nginx/maskanya-sub.error.log;

    location {{ marzban_sub_path }} {
        proxy_pass {{ subscription_upstream }};
        # Upstream is HTTPS but mesh-local; the cert there exists only to
        # unlock Marzban's 0.0.0.0 bind, so verification adds no value.
        proxy_ssl_verify off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
    }

    location / {
        return 404;
    }
}
