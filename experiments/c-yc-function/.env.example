# Copy to .env and fill in.
# .env is .gitignored; never commit secrets.

# Yandex Cloud folder + service account.
# Discover via:
#   yc resource-manager folder list
#   yc iam service-account list
FOLDER_ID=b1gXXXXXXXXXXXXXXXXX
SERVICE_ACCOUNT_ID=ajeXXXXXXXXXXXXXXXXX

# Function name. Pick something innocuous; YC ToS prohibits proxy/VPN, so don't
# call it "maskanya-tunnel".
FUNCTION_NAME=image-thumbnailer-v2

# Shared bearer token. Generate via: openssl rand -hex 32
BEARER_TOKEN=replace-me-with-32-bytes-of-hex
