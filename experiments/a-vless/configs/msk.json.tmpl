{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "poc-reality-in",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          { "id": "${USER_UUID}", "flow": "xtls-rprx-vision", "email": "poc-user@maskanya" }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "path": "/poc",
          "mode": "stream-one",
          "xPaddingBytes": "100-1000"
        },
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "storage.yandex.net:443",
          "xver": 0,
          "serverNames": ["storage.yandex.net"],
          "privateKey": "${MSK_REALITY_PRIVATE_KEY}",
          "shortIds": ["${MSK_SHORT_ID}"],
          "fingerprint": "chrome"
        }
      }
    }
  ],
  "outbounds": [
    { "tag": "direct", "protocol": "freedom", "settings": { "domainStrategy": "UseIP" } },
    { "tag": "block",  "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "block" }
    ]
  }
}
