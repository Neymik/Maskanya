{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "poc-reality-in",
      "listen": "0.0.0.0",
      "port": 2053,
      "protocol": "vless",
      "settings": {
        "clients": [
          { "id": "${CHAIN_UUID}", "flow": "", "email": "poc-chain@maskanya" }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "path": "/poc",
          "mode": "auto",
          "xPaddingBytes": "100-1000"
        },
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "www.cloudflare.com:443",
          "xver": 0,
          "serverNames": ["www.cloudflare.com"],
          "privateKey": "${ZOV_REALITY_PRIVATE_KEY}",
          "shortIds": ["${ZOV_SHORT_ID}"],
          "fingerprint": "chrome"
        }
      }
    }
  ],
  "outbounds": [
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "block", "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "block" }
    ]
  }
}
